<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ======================= Spring Boot Parent ======================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <!-- ======================= Project Metadata ======================= -->
    <groupId>com.atos.paybatch</groupId>
    <artifactId>PayBatchTool</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>PayBatchTool</name>
    <description>Tool for processing batch payment files</description>

    <!-- ======================= Java Version & Encoding ======================= -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skip.codegen>true</skip.codegen>
    </properties>

    <!-- ======================= Dependencies ======================= -->
    <dependencies>

        <!-- ===== SPRING BOOT CORE DEPENDENCIES ===== -->

        <!-- JPA / Hibernate support (compile/runtime) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Aspect-Oriented Programming support (compile/runtime) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Retry logic for Spring components (compile/runtime) -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>

        <!-- Lombok for automatic getters/setters (compile only) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Oracle JDBC driver (runtime only) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson for JSON binding (compile/runtime) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>


        <!-- ===== TESTING ===== -->

        <!-- Spring Boot test utilities (test only) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- ===== SOAP / WSDL / JAXB STACK ===== -->

        <!-- JAX-WS API (compile/runtime) - Defines javax.xml.ws interfaces -->
        <dependency>
            <groupId>javax.xml.ws</groupId>
            <artifactId>jaxws-api</artifactId>
            <version>2.3.1</version>
        </dependency>

        <!-- JAXB API (compile/runtime) - XML binding interfaces -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>

        <!-- JAXB Runtime (runtime) - Implementation of JAXB API -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>2.3.3</version>
        </dependency>

        <!-- SAAJ Implementation (runtime) - Needed for SOAP message creation -->
        <dependency>
            <groupId>com.sun.xml.messaging.saaj</groupId>
            <artifactId>saaj-impl</artifactId>
            <version>1.5.3</version>
        </dependency>

        <!-- Apache CXF JAX-WS frontend (compile/runtime) - SOAP client/server core -->
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-frontend-jaxws</artifactId>
            <version>3.6.3</version>
        </dependency>

        <!-- Apache CXF HTTP transport (compile/runtime) - Required for SOAP over HTTP -->
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-transports-http</artifactId>
            <version>3.6.3</version>
        </dependency>

    </dependencies>

    <!-- ======================= Build & Plugins ======================= -->
    <build>
    <finalName>PayBatchTool</finalName>
        <plugins>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                    <excludes>
                        <!-- Safety measure: exclude generated sources if needed -->
                        <exclude>**/target/generated-sources/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Spring Boot Plugin for packaging the executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>

        <!-- Eclipse lifecycle mapping for ignoring CXF codegen -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.cxf</groupId>
                                        <artifactId>cxf-codegen-plugin</artifactId>
                                        <versionRange>[3.6.0,)</versionRange>
                                        <goals>
                                            <goal>wsdl2java</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore/>
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- ======================= Profile: generate-stubs ======================= -->
    <!-- Run with: mvn clean compile -Pgenerate-stubs -->
    <profiles>
        <profile>
            <id>generate-stubs</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>

            <build>
                <plugins>

                    <!-- CXF Codegen Plugin: Generate stubs from WSDL files -->
                    <plugin>
                        <groupId>org.apache.cxf</groupId>
                        <artifactId>cxf-codegen-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>

                            <!-- Financial Allocation Service -->
                            <execution>
                                <id>generate-financialallocation-stubs</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>wsdl2java</goal>
                                </goals>
                                <configuration>
                                    <sourceRoot>${project.build.directory}/generated-sources/cxf/financialallocation</sourceRoot>
                                    <wsdlOptions>
                                        <wsdlOption>
                                            <wsdl>${project.basedir}/src/main/resources/wsdl/ws_CIL_7_FinancialAllocationWriteService.wsdl</wsdl>
                                            <extraargs>
                                                <extraarg>-xjc-XautoNameResolution</extraarg>
                                                <extraarg>-p</extraarg>
                                                <extraarg>com.atos.paybatch.stubs.financialallocation</extraarg>
                                                <extraarg>-frontend</extraarg>
                                                <extraarg>jaxws21</extraarg>
                                                <extraarg>-validate</extraarg>
                                                <extraarg>-verbose</extraarg>
                                            </extraargs>
                                        </wsdlOption>
                                    </wsdlOptions>
                                </configuration>
                            </execution>

                            <!-- Customer Search Service -->
                            <execution>
                                <id>generate-customersearch-stubs</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>wsdl2java</goal>
                                </goals>
                                <configuration>
                                    <sourceRoot>${project.build.directory}/generated-sources/cxf/customersearch</sourceRoot>
                                    <wsdlOptions>
                                        <wsdlOption>
                                            <wsdl>${project.basedir}/src/main/resources/wsdl/ws_CIL_7_CustomersSearchService.wsdl</wsdl>
                                            <extraargs>
                                                <extraarg>-xjc-XautoNameResolution</extraarg>
                                                <extraarg>-p</extraarg>
                                                <extraarg>com.atos.paybatch.stubs.customersearch</extraarg>
                                                <extraarg>-frontend</extraarg>
                                                <extraarg>jaxws21</extraarg>
                                                <extraarg>-validate</extraarg>
                                                <extraarg>-verbose</extraarg>
                                            </extraargs>
                                        </wsdlOption>
                                    </wsdlOptions>
                                </configuration>
                            </execution>

                        </executions>
                    </plugin>

                    <!-- Copy generated stubs into src/main/java -->
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>copy-stubs-to-src</id>
                                <phase>generate-sources</phase>
                                <configuration>
                                    <target>

                                        <!-- Clean up old stubs -->
                                        <delete dir="${project.basedir}/src/main/java/com/atos/paybatch/stubs/financialallocation"
                                                failonerror="false"/>
                                        <delete dir="${project.basedir}/src/main/java/com/atos/paybatch/stubs/customersearch"
                                                failonerror="false"/>

                                        <!-- Copy new stubs -->
                                        <copy todir="${project.basedir}/src/main/java/com/atos/paybatch/stubs/financialallocation">
                                            <fileset dir="${project.build.directory}/generated-sources/cxf/financialallocation/com/atos/paybatch/stubs/financialallocation"/>
                                        </copy>

                                        <copy todir="${project.basedir}/src/main/java/com/atos/paybatch/stubs/customersearch">
                                            <fileset dir="${project.build.directory}/generated-sources/cxf/customersearch/com/atos/paybatch/stubs/customersearch"/>
                                        </copy>
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>

</project>
